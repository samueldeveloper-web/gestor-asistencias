# Copia este archivo como .env y llena los datos (el .env NO se sube a git)
# --- Base de datos (Neon). Para la versión local: DB_HOST=localhost y DB_SSLMODE=disable
DB_HOST=ep-xxxx-pooler.us-east-1.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=require

# --- JWT
JWT_SECRET=pon-aqui-una-frase-larga-y-secreta
JWT_MINUTOS=480
# false = permite probar las rutas en /docs sin token
AUTH_OBLIGATORIA=true

# --- CORS (URLs del frontend separadas por coma)
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# --- Correo (Gmail: activa verificación en 2 pasos y crea una "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contrasena_de_aplicacion
SMTP_REMITENTE=
NOMBRE_INSTITUCION=Aula Presente
